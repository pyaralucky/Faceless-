# ---------------------------------------------------------------------------
# Faceless AI Studio configuration. Copy to .env and fill in real values.
# Generate secrets:
#   SECRET_KEY:      python -c "import secrets; print(secrets.token_urlsafe(64))"
#   ENCRYPTION_KEYS: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ---------------------------------------------------------------------------
ENVIRONMENT=production
LOG_LEVEL=INFO
LOG_JSON=true

SECRET_KEY=replace-with-64-random-chars
# Comma-separated Fernet keys. First key encrypts; all keys decrypt (prepend a new key to rotate).
ENCRYPTION_KEYS=replace-with-fernet-key

POSTGRES_USER=faceless
POSTGRES_PASSWORD=replace-with-strong-password
POSTGRES_DB=faceless

# Public URLs (used for OAuth redirects, CORS and links)
PUBLIC_API_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
# Instagram downloads media from this base URL; must be publicly reachable over HTTPS in production
MEDIA_PUBLIC_BASE_URL=

# Default LLM when an organization hasn't configured routes. "mock" works offline.
LLM_DEFAULT_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-1
LLM_MAX_RETRIES=3
AGENT_MAX_REVISIONS=2

# Google Cloud OAuth client (YouTube Data API v3 + YouTube Analytics API enabled)
# Authorized redirect URI: ${PUBLIC_API_URL}/api/v1/social/oauth/youtube/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Meta app (Instagram Graph API with Facebook Login for Business)
# Valid OAuth redirect URI: ${PUBLIC_API_URL}/api/v1/social/oauth/instagram/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Rendering
RENDER_PRESET=medium
RENDER_CRF=20
RENDER_FONT_FILE=/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf

# Publishing
PUBLISH_MAX_ATTEMPTS=5
PUBLISH_RETRY_BASE_SECONDS=60
ALLOW_SELF_APPROVAL=false
